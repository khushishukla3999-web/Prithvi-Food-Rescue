# ==============================================================================
# Prithvi Food Rescue — Production Environment Configuration (.env.example)
# ==============================================================================

# Application Base URL
VITE_SITE_URL=https://prithvifoodrescue.org

# Nitro Deployment Target
# Options: cloudflare-module (default) | vercel | netlify | node-server
NITRO_PRESET=cloudflare-module

# Database Configuration (for live persistent data)
# DATABASE_URL=postgresql://user:password@host:5432/prithvix

# Authentication Provider (e.g. Supabase / Clerk / Auth0)
# VITE_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# VITE_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Telemetry / Error Tracking (optional)
# VITE_SENTRY_DSN=
